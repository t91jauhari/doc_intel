# Environment & Secrets
.env
.env.*
!.env.example

# Python runtime & caches
.venv/
venv/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
*.egg-info/
dist/
build/

# Node & Next.js
frontend/node_modules/
frontend/.next/
frontend/out/
*.tsbuildinfo
.npm/

# Local database & storage mounts
data/
engine/outputs/

# Redundant workspace clones and scratch areas
refactor/
sourcecode/
scratch/
scripts/scratch/

# Office documents and test data dumps (preserve official templates and docs)
*.xlsx
!templates/*.xlsx
!docs/**/*.xlsx
~$*.xlsx
*.csv.tmp

# Image & visual dumps
page_rendered.png
*.png.tmp

# Ad-hoc inspection and maintenance scripts
scripts/inspect_*.py
scripts/patch_*.py
scripts/check_*.py
scripts/dump_*.py
scripts/publish_*.py
scripts/run_upgrade_*.py
scripts/scratch_*.py
scripts/set_*.py
scripts/test_*.py
!scripts/test_export_public_source.py
scripts/build_*.py

# Loose scratch files
_enum.py
_tree.txt

# Documentation & markdown files
*.md
**/*.md
